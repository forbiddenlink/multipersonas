# Supabase (required — get from supabase.com dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional safety/ops controls
# AUDIT_DAILY_CALL_CAP=5000
# AUDIT_CALLER_DAILY_CALL_CAP=250
# AUDIT_KILL_SWITCH=0
# GRADE_QUEUE_CAP=25

# Optional Sentry
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
