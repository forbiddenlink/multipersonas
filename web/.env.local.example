# Supabase (required — get from supabase.com dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Anthropic (required — get from console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: override the default Claude model for persona agents
# MULTIPERSONAS_MODEL=claude-sonnet-4-20250514
