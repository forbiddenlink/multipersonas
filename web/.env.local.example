# Supabase (required — get from supabase.com dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional safety/ops controls
# AUDIT_DAILY_CALL_CAP=5000
# AUDIT_CALLER_DAILY_CALL_CAP=250
# AUDIT_KILL_SWITCH=0
# GRADE_QUEUE_CAP=25

# Optional bot protection for public grade + waitlist forms. Set both or neither.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional Sentry
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Optional privacy-conservative product analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional founding-tier checkout. Set this only to a live Stripe Payment Link; when
# unset, /for-agencies stays in qualified-lead mode instead of advertising a price
# without a way to pay.
# NEXT_PUBLIC_FOUNDING_CHECKOUT_URL=https://buy.stripe.com/your-payment-link

# Server-only subscription checkout and entitlement webhook. Use a restricted Stripe key
# with Checkout Session write access; never expose these values to the browser.
# STRIPE_SECRET_KEY=rk_live_...
# STRIPE_FOUNDING_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
