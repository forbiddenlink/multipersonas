# Worker environment — the persistent job runner that claims audit_jobs and runs
# browser audits. Copy to .env and fill in. NEVER commit real values.

# Supabase — the worker writes findings with the service role (bypasses RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry (optional) — error monitoring; no-op if unset.
SENTRY_DSN=

# Worker tuning (all optional; sensible defaults in src/index.ts).
WORKER_POLL_MS=5000
WORKER_JOB_TIMEOUT_SECONDS=300
WORKER_MAX_ATTEMPTS=3
WORKER_REAP_AFTER_SECONDS=600
# Optional webhook pinged on job failures / dead-letters.
WORKER_ALERT_WEBHOOK=
