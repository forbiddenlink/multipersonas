{
  "name": "personaudit",
  "version": "0.1.0",
  "description": "Accessibility scanning that crawls behind a login and runs axe-core at every state it reaches. Keyless CI gate.",
  "type": "module",
  "main": "./dist/agent/orchestrator.js",
  "exports": {
    "./orchestrator": {
      "types": "./dist/agent/orchestrator.d.ts",
      "default": "./dist/agent/orchestrator.js"
    },
    "./engine": {
      "types": "./dist/agent/engine.d.ts",
      "default": "./dist/agent/engine.js"
    },
    "./personas/types": {
      "types": "./dist/personas/types.d.ts",
      "default": "./dist/personas/types.js"
    },
    "./personas/library": {
      "types": "./dist/personas/library.d.ts",
      "default": "./dist/personas/library.js"
    },
    "./personas/generator": {
      "types": "./dist/personas/generator.d.ts",
      "default": "./dist/personas/generator.js"
    },
    "./personas/prebuilt": {
      "types": "./dist/personas/prebuilt.d.ts",
      "default": "./dist/personas/prebuilt.js"
    },
    "./domain/vocab": {
      "types": "./dist/domain/vocab.d.ts",
      "default": "./dist/domain/vocab.js"
    },
    "./security/sentry-scrub": {
      "types": "./dist/security/sentry-scrub.d.ts",
      "default": "./dist/security/sentry-scrub.js"
    },
    "./tasks": {
      "types": "./dist/tasks/definition.d.ts",
      "default": "./dist/tasks/definition.js"
    },
    "./grader": {
      "types": "./dist/grader/scan.d.ts",
      "default": "./dist/grader/scan.js"
    }
  },
  "bin": {
    "personaudit": "./dist/cli.js",
    "mpersonas": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "check:prod-env": "node scripts/check-prod-env.mjs --prod --env-path web/.vercel/.env.production.local",
    "check:bundle": "node scripts/check-bundle-budget.mjs web",
    "smoke:prod": "node scripts/prod-smoke.mjs",
    "test": "vitest run",
    "test:browser": "MP_BROWSER_TESTS=1 vitest run src/agent/browser-conditions.browser.test.ts",
    "test:watch": "vitest",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "axe-core",
    "wcag",
    "testing",
    "ci",
    "playwright",
    "personas",
    "ux"
  ],
  "author": "Elizabeth Stein",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.45",
    "@axe-core/playwright": "^4.13.0",
    "ai": "^7.0.84",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "ora": "^9.4.1",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "next": ">=16.3.3",
      "undici": ">=7.29.0",
      "vite": "8.2.2",
      "postcss": ">=8.5.18",
      "@hono/node-server": ">=2.0.5",
      "hono": ">=4.12.34",
      "nanoid": ">=3.3.17",
      "sharp": ">=0.35.0",
      "js-yaml": ">=4.3.0",
      "fast-uri": ">=3.1.4 <4",
      "uuid": ">=11.1.1"
    }
  },
  "homepage": "https://personaudit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forbiddenlink/multipersonas.git"
  },
  "bugs": {
    "url": "https://github.com/forbiddenlink/multipersonas/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
