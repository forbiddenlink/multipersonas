{
  "name": "multipersonas",
  "version": "0.1.0",
  "description": "AI persona-based website testing CLI",
  "type": "module",
  "main": "./dist/agent/orchestrator.js",
  "exports": {
    "./orchestrator": "./dist/agent/orchestrator.js",
    "./engine": "./dist/agent/engine.js",
    "./personas/types": "./dist/personas/types.js",
    "./personas/library": "./dist/personas/library.js",
    "./personas/generator": "./dist/personas/generator.js",
    "./personas/prebuilt": "./dist/personas/prebuilt.js"
  },
  "bin": {
    "mpersonas": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "accessibility",
    "testing",
    "personas",
    "ux",
    "ai"
  ],
  "author": "Elizabeth Stein",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.96",
    "@axe-core/playwright": "^4.12.1",
    "ai": "^6.0.224",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "playwright": "^1.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
