{
  "name": "multipersonas",
  "version": "0.1.0",
  "description": "AI persona-based website testing CLI",
  "type": "module",
  "main": "./dist/agent/orchestrator.js",
  "exports": {
    "./orchestrator": "./dist/agent/orchestrator.js",
    "./engine": "./dist/agent/engine.js",
    "./personas/types": "./dist/personas/types.js",
    "./personas/library": "./dist/personas/library.js",
    "./personas/generator": "./dist/personas/generator.js",
    "./personas/prebuilt": "./dist/personas/prebuilt.js"
  },
  "bin": {
    "mpersonas": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "accessibility",
    "testing",
    "personas",
    "ux",
    "ai"
  ],
  "author": "Elizabeth Stein",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.96",
    "@axe-core/playwright": "^4.12.1",
    "ai": "^6.0.224",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "playwright": "^1.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.5",
    "eslint": "^9.39.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "next": ">=16.2.11",
      "undici": "^7.28.0",
      "vite": "8.1.5",
      "postcss": ">=8.5.18",
      "@hono/node-server": ">=2.0.5",
      "sharp": ">=0.35.0",
      "js-yaml": ">=4.3.0",
      "fast-uri": ">=3.1.4 <4",
      "uuid": ">=11.1.1"
    }
  }
}
