# Copy to .env (CLI) or web/.env.local (web app). Never commit the filled-in file.

# --- Required: AI ---
# Read implicitly by @ai-sdk/anthropic. Every persona step is one model call.
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: AI ---
# Model used for persona agents. Defaults to claude-sonnet-5 (see src/agent/engine.ts).
# MULTIPERSONAS_MODEL=claude-sonnet-5

# --- Required for the web app only (web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Web app: durable rate limit + spend cap (server-only) ---
# Service-role key. Server-side ONLY — never expose to the client. Without it, the
# durable rate limit and spend cap are DISABLED (allow + warn); REQUIRED before any
# public deploy. See docs/PLAN-2026-07-26-phase2-deploy-infra.md.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Global daily model-call ceiling across all users (optional; defaults to 5000).
# AUDIT_DAILY_CALL_CAP=5000
# Per-caller daily model-call ceiling, beneath the global cap (optional; defaults to 250
# ≈ 10 audits/caller/day). Keep it a SMALL fraction of the global cap so draining the whole
# day's budget needs many distinct identities, not a handful. Raise for a known power user.
# AUDIT_CALLER_DAILY_CALL_CAP=250
# Emergency stop — set to 1 to freeze all audit runs regardless of limits.
# AUDIT_KILL_SWITCH=0

# --- Web app: public form bot protection (optional) ---
# Set BOTH keys together; production deploy checks fail on a half-configured Turnstile pair.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...
# TURNSTILE_SECRET_KEY=0x4AAAA...

# Optional: Stripe Payment Link for founding access ($199/mo). Unset = waitlist-only on /for-agencies.
# NEXT_PUBLIC_FOUNDING_CHECKOUT_URL=https://buy.stripe.com/...

# Optional: "Request Pro access" mailto. Unset falls back to /for-agencies (never /waitlist).
# NEXT_PUBLIC_SUPPORT_EMAIL=hello@personaudit.com

# --- Worker: browser egress hardening (SSRF / DNS-rebinding) ---
# Force the persistent worker's Chromium to egress through a smokescreen-style proxy that
# re-validates every destination against a private/reserved-range denylist at CONNECT time.
# This is what actually closes the DNS-rebinding TOCTOU (url-guard validates the resolved IP,
# but Chromium re-resolves on connect). See docs/ssrf-egress-hardening.md.
# AUDIT_BROWSER_PROXY=http://smokescreen:4750
# Fail closed: set to 1 on the hosted worker so it REFUSES to launch the browser if
# AUDIT_BROWSER_PROXY is unset (rather than silently launching with the rebinding hole open).
# AUDIT_REQUIRE_EGRESS_PROXY=1
# Force the irreversible-action guard on (never click "Place Order"/"Delete Account" on a
# stranger's live site). The worker sets this to 1 itself; documented here for visibility.
# MP_BLOCK_DESTRUCTIVE_ACTIONS=1

# --- Error tracking: Sentry (optional; ships disabled until DSN set) ---
# Required for error capture (web client + server, and the worker). Without it Sentry.init
# is a documented no-op, so a fresh deploy silently reports nothing until this is set.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oyyy.ingest.sentry.io/zzzz   # web (client + server)
# SENTRY_DSN=https://xxxx@oyyy.ingest.sentry.io/zzzz              # worker
# Build-only: source-map upload in withSentryConfig is skipped UNLESS all three are set in
# the build env (Vercel prod env, since deploy is a manual `vercel --prod`). Missing = prod
# Sentry issues show minified stack traces with no source line.
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
